  "metadata": "{\"compiler\":{\"version\":\"0.8.20+commit.a1b79de6\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[{\"internalType\":\"address\",\"name\":\"_arbiter\",\"type\":\"address\"}],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"OrderCompleted\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"buyer\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"seller\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"deadline\",\"type\":\"uint256\"}],\"name\":\"OrderCreated\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"},{\"indexed\":false,\"internalType\":\"address\",\"name\":\"by\",\"type\":\"address\"}],\"name\":\"OrderDisputed\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"OrderPaid\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"OrderRefunded\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"},{\"indexed\":false,\"internalType\":\"bool\",\"name\":\"sellerWins\",\"type\":\"bool\"}],\"name\":\"OrderResolved\",\"type\":\"event\"},{\"inputs\":[],\"name\":\"arbiter\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"confirm\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"seller\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"deadline\",\"type\":\"uint256\"},{\"internalType\":\"string\",\"name\":\"description\",\"type\":\"string\"}],\"name\":\"createOrder\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"deposit\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"dispute\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"getOrder\",\"outputs\":[{\"components\":[{\"internalType\":\"address\",\"name\":\"buyer\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"seller\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"deadline\",\"type\":\"uint256\"},{\"internalType\":\"enum Escrow.Status\",\"name\":\"status\",\"type\":\"uint8\"},{\"internalType\":\"string\",\"name\":\"description\",\"type\":\"string\"}],\"internalType\":\"struct Escrow.Order\",\"name\":\"\",\"type\":\"tuple\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"orderCount\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"refund\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"},{\"internalType\":\"bool\",\"name\":\"sellerWins\",\"type\":\"bool\"}],\"name\":\"resolve\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/Escrow.sol\":\"Escrow\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\",\"useLiteralContent\":true},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"contracts/Escrow.sol\":{\"content\":\"// SPDX-License-Identifier: MIT\\npragma solidity >=0.8.0 <0.9.0;\\n\\n// \\u53ea\\u58f0\\u660e\\u6211\\u4eec\\u8981\\u7528\\u7684\\u4e09\\u4e2a\\u51fd\\u6570\\u3002Escrow \\u901a\\u8fc7\\u8fd9\\u4e2a\\u63a5\\u53e3\\u53bb\\u8c03\\u7528\\u4efb\\u4f55 ERC20 \\u5408\\u7ea6\\u3002\\ninterface IERC20 {\\n    function transfer(address to, uint256 value) external returns (bool);\\n\\n    function transferFrom(\\n        address from,\\n        address to,\\n        uint256 value\\n    ) external returns (bool);\\n\\n    function balanceOf(address account) external view returns (uint256);\\n}\\n\\ncontract Escrow {\\n    // ---------- \\u72b6\\u6001\\u673a ----------\\n    enum Status { Created, Paid, Completed, Refunded, Disputed }\\n\\n    struct Order {\\n        address buyer;\\n        address seller;\\n        address token; // \\u7528\\u54ea\\u79cd ERC20 \\u7ed3\\u7b97\\n        uint256 amount; // \\u6700\\u5c0f\\u5355\\u4f4d\\n        uint256 deadline; // unix \\u65f6\\u95f4\\u6233\\uff0c\\u79d2\\n        Status status;\\n        string description;\\n    }\\n\\n    // ---------- \\u5b58\\u50a8 ----------\\n    address public arbiter;\\n    uint256 public orderCount;\\n    mapping(uint256 => Order) private _orders;\\n\\n    // ---------- \\u4e8b\\u4ef6 ----------\\n    event OrderCreated(\\n        uint256 indexed id,\\n        address indexed buyer,\\n        address indexed seller,\\n        address token,\\n        uint256 amount,\\n        uint256 deadline\\n    );\\n    event OrderPaid(uint256 indexed id);\\n    event OrderCompleted(uint256 indexed id);\\n    event OrderRefunded(uint256 indexed id);\\n    event OrderDisputed(uint256 indexed id, address by);\\n    event OrderResolved(uint256 indexed id, bool sellerWins);\\n\\n    // ---------- \\u4fee\\u9970\\u5668 ----------\\n    modifier onlyArbiter() {\\n        require(msg.sender == arbiter, \\\"Escrow: caller is not the arbiter\\\");\\n        _;\\n    }\\n\\n    modifier onlyBuyer(uint256 id) {\\n        require(\\n            msg.sender == _orders[id].buyer,\\n            \\\"Escrow: caller is not the buyer\\\"\\n        );\\n        _;\\n    }\\n\\n    modifier inStatus(uint256 id, Status s) {\\n        require(_orders[id].status == s, \\\"Escrow: wrong status\\\");\\n        _;\\n    }\\n\\n    constructor(address _arbiter) {\\n        require(_arbiter != address(0), \\\"Escrow: arbiter is the zero address\\\");\\n        arbiter = _arbiter;\\n    }\\n\\n    function getOrder(uint256 id) public view returns (Order memory) {\\n        require(id < orderCount, \\\"Escrow: order does not exist\\\");\\n        return _orders[id];\\n    }\\n\\n    // ---------- TODO 1\\uff1a\\u521b\\u5efa\\u8ba2\\u5355 ----------\\n    function createOrder(\\n        address seller,\\n        address token,\\n        uint256 amount,\\n        uint256 deadline,\\n        string memory description\\n    ) public returns (uint256) {\\n        require(seller != address(0), \\\"Escrow: seller is the zero address\\\");\\n        require(seller != msg.sender, \\\"Escrow: seller is the buyer\\\");\\n        require(amount > 0, \\\"Escrow: amount must be positive\\\");\\n        require(\\n            deadline > block.timestamp,\\n            \\\"Escrow: deadline must be in the future\\\"\\n        );\\n\\n        uint256 id = orderCount;\\n\\n        _orders[id] = Order({\\n            buyer: msg.sender,\\n            seller: seller,\\n            token: token,\\n            amount: amount,\\n            deadline: deadline,\\n            status: Status.Created,\\n            description: description\\n        });\\n\\n        orderCount += 1;\\n\\n        emit OrderCreated(\\n            id,\\n            msg.sender,\\n            seller,\\n            token,\\n            amount,\\n            deadline\\n        );\\n\\n        return id;\\n    }\\n\\n    // ---------- TODO 2\\uff1a\\u4e70\\u5bb6\\u4ed8\\u6b3e ----------\\n    function deposit(uint256 id)\\n        public\\n        onlyBuyer(id)\\n        inStatus(id, Status.Created)\\n    {\\n        Order storage o = _orders[id];\\n\\n        o.status = Status.Paid;\\n\\n        require(\\n            IERC20(o.token).transferFrom(o.buyer, address(this), o.amount),\\n            \\\"Escrow: transferFrom failed\\\"\\n        );\\n\\n        emit OrderPaid(id);\\n    }\\n\\n    // ---------- TODO 3\\uff1a\\u4e70\\u5bb6\\u786e\\u8ba4\\u6536\\u8d27 ----------\\n    function confirm(uint256 id)\\n        public\\n        onlyBuyer(id)\\n        inStatus(id, Status.Paid)\\n    {\\n        Order storage o = _orders[id];\\n\\n        o.status = Status.Completed;\\n\\n        require(\\n            IERC20(o.token).transfer(o.seller, o.amount),\\n            \\\"Escrow: transfer failed\\\"\\n        );\\n\\n        emit OrderCompleted(id);\\n    }\\n\\n    // ---------- TODO 4\\uff1a\\u8d85\\u671f\\u9000\\u6b3e ----------\\n    function refund(uint256 id)\\n        public\\n        onlyBuyer(id)\\n        inStatus(id, Status.Paid)\\n    {\\n        Order storage o = _orders[id];\\n\\n        require(\\n            block.timestamp > o.deadline,\\n            \\\"Escrow: deadline has not passed\\\"\\n        );\\n\\n        o.status = Status.Refunded;\\n\\n        require(\\n            IERC20(o.token).transfer(o.buyer, o.amount),\\n            \\\"Escrow: transfer failed\\\"\\n        );\\n\\n        emit OrderRefunded(id);\\n    }\\n\\n    // ---------- TODO 5\\uff1a\\u53d1\\u8d77\\u4e89\\u8bae ----------\\n    function dispute(uint256 id)\\n        public\\n        inStatus(id, Status.Paid)\\n    {\\n        Order storage o = _orders[id];\\n\\n        require(\\n            msg.sender == o.buyer || msg.sender == o.seller,\\n            \\\"Escrow: caller is not the buyer or seller\\\"\\n        );\\n\\n        o.status = Status.Disputed;\\n\\n        emit OrderDisputed(id, msg.sender);\\n    }\\n\\n    // ---------- TODO 6\\uff1a\\u4ef2\\u88c1 ----------\\n    function resolve(uint256 id, bool sellerWins)\\n        public\\n        onlyArbiter\\n        inStatus(id, Status.Disputed)\\n    {\\n        Order storage o = _orders[id];\\n\\n        if (sellerWins) {\\n            o.status = Status.Completed;\\n\\n            require(\\n                IERC20(o.token).transfer(o.seller, o.amount),\\n                \\\"Escrow: transfer failed\\\"\\n            );\\n        } else {\\n            o.status = Status.Refunded;\\n\\n            require(\\n                IERC20(o.token).transfer(o.buyer, o.amount),\\n                \\\"Escrow: transfer failed\\\"\\n            );\\n        }\\n\\n        emit OrderResolved(id, sellerWins);\\n    }\\n}\\n\",\"keccak256\":\"0xa3046b66d4cbe3759ba6e925df7bda8c4405ec77dcbeedf494f593611ba050b1\",\"license\":\"MIT\"}},\"version\":1}",
